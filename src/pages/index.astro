---
import Layout from '../layouts/Layout.astro';
import { totalItems } from '../data/catalog';
---
<Layout title="Главная">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Магазин техники</p>
      <h1 class="stretch">
        <span class="num">{totalItems}</span>
        <span class="word">позиций</span>
      </h1>
      <p class="lead">Процессоры, видеокарты, память и всё для сборки. Выберите категорию и найдите нужное.</p>
      <a class="btn" href="/catalog">Открыть каталог →</a>
    </div>

    <div class="hero-logo" aria-hidden="true">
      <div class="ring r1"></div>
      <div class="ring r2"></div>
      <div class="core">p<i></i></div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 80px);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 2rem;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
  }
  .hero-text { display: grid; gap: 1.5rem; justify-items: start; }

  /* Растянутый счётчик, как обои на экране блокировки */
  .stretch {
    display: flex;
    flex-direction: column;
    font-weight: 200;
    letter-spacing: -0.05em;
    line-height: 0.82;
  }
  .stretch .num {
    font-size: clamp(7rem, 22vw, 18rem);
    transform: scaleY(1.25);
    transform-origin: left top;
    color: var(--fg);
  }
  .stretch .word {
    font-size: clamp(2.5rem, 8vw, 6rem);
    transform: scaleY(1.25);
    transform-origin: left top;
    color: var(--accent);
    margin-top: 0.2em;
  }
  .lead { color: var(--muted); max-width: 36ch; line-height: 1.6; }

  /* Анимированный логотип */
  .hero-logo {
    position: relative;
    aspect-ratio: 1;
    width: min(70vw, 420px);
    justify-self: center;
    display: grid;
    place-items: center;
  }
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  .ring.r1 { animation: spin 18s linear infinite; border-top-color: var(--accent); }
  .ring.r2 { inset: 12%; animation: spin 28s linear infinite reverse; border-style: dashed; }
  .core {
    position: relative;
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 200;
    letter-spacing: -0.04em;
    animation: breathe 3s var(--ease) infinite alternate;
  }
  .core i {
    position: absolute;
    right: -0.12em;
    bottom: 0.2em;
    width: 0.18em;
    height: 0.18em;
    border-radius: 50%;
    background: var(--accent);
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes breathe { from { transform: scale(0.97); } to { transform: scale(1); } }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; text-align: left; }
    .hero-logo { order: -1; width: 60vw; }
  }
</style>
